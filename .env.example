PUBLIC_BASE_URL=http://localhost:8000
DATABASE_PROVIDER=sqlite
DATABASE_URL=sqlite:///data/feedback.sqlite
# PostgreSQL: set DATABASE_PROVIDER=postgres and a PostgreSQL connection URI.
# Supabase: set DATABASE_PROVIDER=supabase and use the direct or session-pooler URI.
# Both require APPLICATION_SECRET. See docs/database-providers.md.
# DATABASE_URL=postgresql://supaknock:URL_ENCODED_PASSWORD@db.example.com:5432/supaknock?sslmode=require
DATA_DIR=/data
HOST_PORT=8000
BIND_ADDRESS=127.0.0.1
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
ALLOW_INTERNAL_WEBHOOKS=false
# Explicit opt-in for private/custom HTTP AI endpoints. Metadata addresses stay blocked.
ALLOW_INTERNAL_AI_ENDPOINTS=false
ALLOW_INTERNAL_RELAY=false
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
# SQLite can generate both secrets under /data. PostgreSQL/Supabase always need
# an explicit APPLICATION_SECRET, kept unchanged across restarts and restores.
# SETUP_TOKEN=at-least-24-random-characters
# APPLICATION_SECRET=a-Fernet-key-from-the-command-in-README
# For direct Python runs:
# Override DATABASE_URL with an absolute host path for a direct Python run.
# PORT=8000
# Only trust the actual reverse proxy IPs, never arbitrary client forwarding headers.
# Used for rate limits and private connection-IP history. Keep the app port private.
# TRUSTED_PROXY_IPS=172.18.0.2
